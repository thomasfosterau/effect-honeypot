{
  "name": "@thomasfosterau/effect-honeypot-common",
  "version": "0.1.0",
  "description": "Honeypot traps for framework-agnostic probes: dotfiles, VCS metadata, backups, admin panels and more.",
  "keywords": [
    "effect",
    "honeypot",
    "http",
    "middleware",
    "security"
  ],
  "license": "MIT",
  "author": "Thomas Foster",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/thomasfosterau/effect-honeypot.git",
    "directory": "packages/common"
  },
  "files": [
    "dist",
    "src"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "./package.json": "./package.json"
    },
    "access": "public"
  },
  "scripts": {
    "build": "vp pack"
  },
  "dependencies": {
    "@thomasfosterau/effect-honeypot-core": "workspace:^"
  },
  "devDependencies": {
    "effect": "catalog:"
  },
  "peerDependencies": {
    "effect": "^4.0.5"
  }
}
