{
  "name": "effect-honeypot",
  // The Vite+ base image (Node + pnpm + the vp CLI), tagged at the catalog's
  // `vite-plus` pin in pnpm-workspace.yaml (1.5.0). Dependabot's `devcontainers`
  // updates move only the features below, so bump this tag by hand on the
  // toolchain PR that moves `vite-plus`.
  "image": "ghcr.io/voidzero-dev/vite-plus:1.5.0",
  "features": {
    "ghcr.io/devcontainers/features/github-cli:1": {},
    "ghcr.io/devcontainers-extra/features/ripgrep:1.0.15": {},
    "ghcr.io/anthropics/devcontainer-features/claude-code:1.0": {},
    "ghcr.io/devcontainer-community/devcontainer-features/jq:1": {}
  },
  // The same script as the SessionStart hook, so a Codespace is provisioned
  // like an agent session: the global Vite+ at the catalog pin, `vp` / `vpx`
  // linked into ~/.local/bin, then `vp install --frozen-lockfile` (which runs
  // the `prepare` step: git hooks and the `effect-tsgo` patch).
  "postCreateCommand": "bash .claude/hooks/session-start.sh",
  "customizations": {
    "vscode": {
      "extensions": ["Anthropic.claude-code", "oxc.oxc-vscode"]
    }
  },
  "workspaceFolder": "/workspaces/effect-honeypot"
}
