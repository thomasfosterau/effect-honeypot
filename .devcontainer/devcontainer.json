{
  "name": "effect-honeypot",
  // The Vite+ base image (Node + pnpm + the vp CLI), tagged at the catalog's
  // `vite-plus` pin in pnpm-workspace.yaml (1.5.0). Dependabot's `devcontainers`
  // updates move only the features below, so bump this tag by hand on the
  // toolchain PR that moves `vite-plus`.
  "image": "ghcr.io/voidzero-dev/vite-plus:1.5.0",
  "features": {
    "ghcr.io/devcontainers/features/github-cli:1": {},
    "ghcr.io/devcontainers-extra/features/ripgrep:1": {},
    "ghcr.io/anthropics/devcontainer-features/claude-code:1.0": {},
    "ghcr.io/devcontainer-community/devcontainer-features/jq:1": {}
  },
  // This repository has no SessionStart provisioning hook, so the container
  // installs dependencies against the lockfile with the image's own `vp`, which
  // also runs the `prepare` step (git hooks and the `effect-tsgo` patch).
  "postCreateCommand": "vp install --frozen-lockfile",
  "customizations": {
    "vscode": {
      "extensions": ["Anthropic.claude-code", "oxc.oxc-vscode"]
    }
  },
  "workspaceFolder": "/workspaces/effect-honeypot"
}
